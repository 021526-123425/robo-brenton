sudo su -_Brenton-Hopkinns
if [[ $- == *i* ]]; then
    if [[ -n $(trap -p DEBUG) ]]; then
        printf '%s\n' 'Sanctuary guard not installed: a DEBUG trap already exists.' >&2
    else
        shopt -s extdebug
        trap '
            case $BASH_COMMAND in
                *ssuccubus*|*theincubus*|*vvampire*|*volturite*|*jellybean*)
                    printf "\nSanctuary: matching command blocked; typed text remains visible.\n" >&2
                    false
                    ;;
            esac
        ' DEBUG
    fi
fi
